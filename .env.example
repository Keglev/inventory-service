# =========================================================
# Oracle Autonomous Database (Wallet-Based Connection)
# =========================================================
# The TNS_ADMIN path must point to your unzipped Oracle Wallet directory.
TNS_ADMIN=/path/to/your/wallet_directory

# Wallet password: the prod profile hands it to the Oracle driver, and
# scripts/start.sh refuses to start the container without it.
ORACLE_WALLET_PASSWORD=your_wallet_password

# Container only: the zipped wallet, base64-encoded. scripts/start.sh unpacks
# it and sets TNS_ADMIN itself; a local run uses TNS_ADMIN above instead.
ORACLE_WALLET_B64=base64_of_the_wallet_zip

# Oracle JDBC connection string (replace with your service details)
DB_URL=jdbc:oracle:thin:@your_db_service_name

# Oracle DB credentials (typically ADMIN for Free Tier)
DB_USER=your_db_user
DB_PASS=your_db_password

# =========================================================
# Google OAuth2 Credentials
# =========================================================
# Used for securing login via Google SSO. Spring reads these exact names.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=your_google_client_id
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Sign-in allow-list and admin role (comma-separated, case-insensitive).
# Empty means nobody can sign in.
APP_ADMIN_EMAILS=you@example.com

# =========================================================
# Wallet Test Flag (Optional)
# =========================================================
# Set to true to run the Oracle smoke test (InventoryServiceApplicationTest,
# oracle-it profile); see docs/backend/architecture/oracle-it-smoke-test.md
ENABLE_WALLET_TEST=false

