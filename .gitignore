# Java + Spring Boot: Target Build Output
target/
!/.mvn/wrapper/maven-wrapper.jar

# Log Output and Temporary Files
logs/
*.log

# IDE and Build Tool Metadata
# IntelliJ IDEA
.idea
*.iws
*.iml
*.ipr

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# Local dev HTTPS certs
*.pem
frontend/cert/

# Docker
*.pid
docker-compose.override.yml

# Oracle Wallet / Sensitive Credentials
wallet_*.*
oracle_wallet/
*.ora
*.p12
*.sso
*.jks
*.zip
oracle_wallet.zip
oracle_wallet_b64.txt

# keep env files private by default (a pattern without a slash matches at any
# depth, so these cover frontend/ as well)
.env
*.env
.env.local
.env.*.local

# Node.js Frontend Output
/frontend/node_modules/
/frontend/dist/
/docs/node_modules/
docs/frontend/coverage/
docs/frontend/api/

# Java Class Files
*.class

# Documentation
# Generated HTML files (published to gh-pages branch only)
docs/backend/coverage/

# archive of docs backups
/docs/_bak/

# Local coding-agent configuration
# The coding agent's settings configure one machine, not the project, and can carry
# local paths; the standards it follows come with each change's instructions.
.claude/
