; npm cannot resolve this tree without this flag. i18next 25.x and
; react-i18next 15.x both declare a peer of typescript ^5, and this project
; builds on typescript 6. npm ci is unaffected -- it installs from the
; lockfile and never re-resolves -- so the conflict stayed invisible until an
; install was attempted. Measured 2026-09-03: npm install fails with ERESOLVE
; without this line.
;
; This is a workaround for an upgrade that has not happened yet. i18next 26.x
; and react-i18next 17.x accept typescript 6; once both are upgraded, delete
; this file and confirm npm install resolves unaided.
legacy-peer-deps=true
