// Root TypeScript configuration — entry point for project references.
// Contains no source itself; delegates to tsconfig.app.json, tsconfig.node.json,
// tsconfig.test.json and tsconfig.e2e.json via tsc --build. It holds no
// compilerOptions or exclude: with "files": [] they would apply to nothing, and
// referenced projects do not inherit them.

{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.test.json" },
    { "path": "./tsconfig.e2e.json" }
  ]
}
