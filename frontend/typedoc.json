// TypeDoc configuration for generating API documentation from TypeScript source.
// Outputs Markdown rather than HTML so the docs pipeline can consume it without
// a separate rendering step.

{
  "entryPoints": [
    "src/api/**/*.ts",
    "src/context/**/*.ts",
    "src/context/**/*.tsx"
  ],
  // expand treats each entry point as a glob, emitting one doc page per matched file
  // rather than merging them into a single module page.
  "entryPointStrategy": "expand",
  "out": "docs",
  "tsconfig": "tsconfig.app.json",
  "plugin": ["typedoc-plugin-markdown"],
  // markdown theme is required by typedoc-plugin-markdown; the default HTML theme
  // is incompatible with the plugin.
  "theme": "markdown",
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.stories.tsx",
    "**/__mocks__/**",
    "**/vite-env.d.ts",
    "**/main.tsx",
    "**/App.tsx"
  ],
  // Suppresses TypeDoc's default behaviour of prepending the project README to generated docs.
  "readme": "none",

  // blockTags REPLACES TypeDoc's defaults rather than extending them: measured
  // 2026-09-03, declaring only the three project tags took the warning count from
  // 64 to 241 because @param, @returns, @module and @summary became unknown. The
  // 42 defaults for typedoc 0.28 are therefore listed first, then the tags this
  // project uses: @file names the source file, @enterprise records the rationale
  // a reviewer needs, @backend cites the endpoint a fetcher calls.
  "blockTags": [
    "@defaultValue", "@deprecated", "@example", "@jsx", "@param", "@privateRemarks",
    "@remarks", "@returns", "@see", "@throws", "@typeParam", "@author",
    "@callback", "@category", "@categoryDescription", "@default", "@document", "@extends",
    "@augments", "@yields", "@group", "@groupDescription", "@import", "@inheritDoc",
    "@license", "@module", "@mergeModuleWith", "@prop", "@property", "@return",
    "@satisfies", "@since", "@sortStrategy", "@template", "@this", "@type",
    "@typedef", "@summary", "@preventInline", "@inlineType", "@preventExpand", "@expandType",
    "@file", "@enterprise", "@backend"
  ]
}
