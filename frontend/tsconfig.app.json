// TypeScript configuration for application source files under src/.
// Test files are excluded and covered by tsconfig.test.json, which extends this
// config with test-specific type declarations without exposing them to production source.

{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["vite/client"],

    "moduleResolution": "bundler",
    // Permits import paths ending in .ts (possible only with noEmit).
    // TODO(S-4): no app file imports with a .ts extension; drop with a tsc -b check.
    "allowImportingTsExtensions": true,
    // Type-only imports must say `import type`, so Vite's per-file transform
    // (Rolldown/Oxc in Vite 8) can drop them without type information.
    "verbatimModuleSyntax": true,
    // Treats every file as a module; prevents files with no imports/exports from
    // leaking declarations into the global scope.
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    // Relative to this file. No baseUrl: TypeScript 6 deprecates it (removed in
    // 7) and paths no longer needs it.
    "paths": {
      "@/*": ["./src/*"]
    },

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Only TypeScript syntax a per-file transform can erase: no enums, namespaces
    // or parameter properties, which need code generated for them.
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    // A side-effect import (import './x.css') must resolve; TypeScript otherwise
    // skips an unresolved one silently.
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "exclude": ["src/__tests__/**", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"]
}
