// TypeScript configuration for test files.
// Extends tsconfig.app.json rather than standing alone so test code shares the same
// strict compiler rules; separated only to layer in test-specific type declarations
// (vitest/globals, @testing-library/jest-dom) without exposing them to production source.

{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    // vitest/globals matches globals: true in vitest.config.ts. "node" serves
    // setupTests.ts (createRequire, Module._load) and is declared, not left to
    // arrive through jest-dom's /// <reference types="jest" />.
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/__tests__/**/*.ts",
    "src/__tests__/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
