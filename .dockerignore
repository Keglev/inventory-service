# .dockerignore - the build context of both images (backend and frontend Dockerfile,
# both built from the repository root). Keeps the context small and free of local
# secrets, and keeps what a Dockerfile COPYs (.mvn/, ops/nginx/, frontend/ sources).

# VCS / repo metadata
.git
.gitignore
.github/

# IDE & local tooling
.vscode
.idea
*.iml
*.classpath
*.project
.settings/

# OS cruft
**/.DS_Store
Thumbs.db

# Environment files & local secrets (NEVER bake secrets into images)
# A pattern here matches from the context root only, unlike .gitignore, so each
# one carries **/ to reach frontend/ as well, where Vite would load a local file
# into a production build. Tracked env files (.env.production) stay in.
**/.env
**/.env.local
**/.env.*.local

# Backend: build outputs & logs
target/
**/logs/
**/log/
*.log
out/
test-output/

# Test source code (NEVER include in production images)
src/test/

# Documentation & coverage reports (GitHub Pages only, never in Docker)
docs/
*.md

# Maven wrapper launchers; .mvn/ stays in, the backend Dockerfile copies it
mvnw
mvnw.cmd

# Oracle Wallet & related sensitive artifacts (kept out of context)
wallet/
oracle_wallet/
wallet.zip
*.zip
*.pem
tnsnames.ora
sqlnet.ora
cwallet.sso
ewallet.p12

# Frontend outputs and specs; the image builds node_modules and dist itself
frontend/dist
frontend/coverage
frontend/cert
frontend/src/**/*.test.*
frontend/src/**/*.spec.*

# Node caches ANYWHERE in the tree (frontend or otherwise)
**/node_modules
**/npm-debug.log
npm-debug.log*
yarn-error.log*

# Local compose & misc (not needed inside images)
docker-compose.yml
